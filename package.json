{
  "name": "my-nextjs-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/app/components/ActivityCombinations/core/__tests__/",
    "test:planner": "vitest run --config vitest.config.mts",
    "test:planner:watch": "vitest --config vitest.config.mts",
    "sync:photos": "node scripts/sync-photo-images.mjs",
    "git": "next build && git add . && git commit -m 'Update' && git push origin updates",
    "reel": "tsx reels/render.ts",
    "reel:font": "node scripts/fetch-reel-font.mjs",
    "reel:check": "tsc -p reels/tsconfig.json"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "20.19.42",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@vitest/coverage-v8": "^4.1.8",
    "d3-geo": "^3.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fast-check": "^4.8.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.8",
    "world-atlas": "^2.0.2"
  }
}
