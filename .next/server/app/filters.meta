{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/filters/layout,_N_T_/filters/page,_N_T_/filters"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/filters/__PAGE__",
    "/filters",
    "/_index",
    "/_head"
  ]
}